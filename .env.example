# Stage 1 permits only PayPal sandbox credentials from the local environment.
# Future development must use a dedicated secret manager; do not add credentials here.
HBIEPA_OPERATION_MODE=sandbox-simulation
# Optional. Keep real values in the local environment, never in this file.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Sandbox Business-account merchant ID, used to verify that retrieved Orders belong to the expected merchant.
PAYPAL_SANDBOX_MERCHANT_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
# Must remain exact if supplied; live endpoints are rejected.
PAYPAL_API_ORIGIN=https://api-m.sandbox.paypal.com
# Local, loopback-only webhook receiver. Do not use a production hostname.
HBIEPA_SQLITE_PATH=.hbiepa-data/hbiepa-stage1a.sqlite
HBIEPA_LOCAL_WEBHOOK_HOST=127.0.0.1
HBIEPA_LOCAL_WEBHOOK_PORT=8787
HBIEPA_LOCAL_WEBHOOK_PATH=/webhooks/paypal/sandbox
# Keep this test-only mode until credentials and a registered sandbox webhook ID are configured.
# Set exactly sandbox-verified only for an approved genuine sandbox delivery test.
HBIEPA_WEBHOOK_MODE=synthetic-only
# Browser redirect only; it is not payment evidence.  The sandbox Order runner independently retrieves every Order.
HBIEPA_SANDBOX_RETURN_URL=https://example.com/hbiepa/sandbox-return
HBIEPA_SANDBOX_CANCEL_URL=https://example.com/hbiepa/sandbox-cancel
# Optional genuine-AI provider. Leave unset to keep the offline demo mode.
# Ollama accepts only a local loopback HTTP endpoint and needs no credentials.
HBIEPA_AI_PROVIDER=
HBIEPA_OLLAMA_MODEL=qwen2.5-coder:7b
HBIEPA_OLLAMA_BASE_URL=http://127.0.0.1:11434
HBIEPA_OLLAMA_TIMEOUT_MS=60000
# OpenAI remains optional; never put a real key in source control or browser code.
OPENAI_API_KEY=
HBIEPA_AI_MODEL=gpt-4o-mini
HBIEPA_AI_REQUEST_TIMEOUT_MS=15000
# Loopback-only hackathon demonstration server.
HBIEPA_DEMO_PORT=3030
